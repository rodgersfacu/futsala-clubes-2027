data/
*.db
*.db-wal
*.db-shm
*.db.respaldo-*

# Respaldos, exportaciones y planillas: mismos datos, otro formato.
exportaciones/
*.xlsx
*.csv

# Nombres y correos de personas reales. equipo.ejemplo.json sí se versiona.
equipo.json

# --- Secretos ---------------------------------------------------------------
.env
secreto-sesion.txt
enlaces-de-acceso.log

# --- De cada instalación ----------------------------------------------------
# Dónde quedó la base en esta máquina.
datos.ubicacion

# --- Varios -----------------------------------------------------------------
node_modules/
*.zip
Thumbs.db
.DS_Store

# Dossier interno: dice cuántos clubes y cuántas tiras tiene la liga, el proceso
# de venta y los límites conocidos. Está marcado "uso interno" en su propia
# portada. Si se decide publicarlo, basta con sacar esta línea.
docs/REVISION_EXTERNA.md
